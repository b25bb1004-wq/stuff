fn print(s: str) uses io = extern "io.print"
fn read_line() -> str? uses io = extern "io.read_line"
fn now() -> int uses time = extern "time.now"
fn random() -> int uses rand = extern "rand.next"
fn read_file(path: str) -> [byte]? uses fs = extern "fs.read"
fn write_file(path: str, data: [byte]) -> bool uses fs = extern "fs.write"
fn storage_get(key: [byte]) -> [byte]? uses chain = extern "chain.get"
fn storage_set(key: [byte], value: [byte]) uses chain = extern "chain.set"
fn caller() -> [byte] uses chain = extern "chain.caller"
fn emit(event: str) uses chain = extern "chain.emit"
